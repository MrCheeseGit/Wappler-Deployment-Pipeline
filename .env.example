# Optional — only needed if docker compose cannot see your home directory (common on Windows).
# Copy to .env and edit, then: docker compose up -d --build
#
# Linux/macOS: you can usually skip this file and run docker compose directly.

# Your home directory (must match the path Docker should mount)
# HOME=/home/you
# HOME=/Users/you

# Optional port if 8900 is already in use
# WDP_PORT=9900
