# Session secret — generate a strong value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string

# Server binding
HOST=0.0.0.0
PORT=3001

# Persistent data directories (use a Docker volume in production)
SESSION_DIR=/data/sessions
CONFIG_PATH=/data/wdp-config.json
